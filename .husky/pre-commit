set -e
# Load cargo onto PATH for GUI git clients (Cursor, VS Code, GitHub Desktop) launched
# by launchd, which do not source the interactive shell profile. Skipped when cargo is
# already on PATH, so it never shadows a cargo supplied by Nix, asdf or Homebrew.
if ! command -v cargo >/dev/null 2>&1 && [ -f "$HOME/.cargo/env" ]; then . "$HOME/.cargo/env"; fi
cargo fmt --all --check
